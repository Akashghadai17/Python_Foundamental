All OS
------
chdir()         # Change directory
getcwd()        # Get current directory
listdir()       # List files and folders
mkdir()         # Create directory
makedirs()      # Create nested directories
rmdir()         # Remove empty directory
removedirs()    # Remove nested directories

remove()        # Delete file
rename()        # Rename file/folder
replace()       # Replace file

stat()          # File information
chmod()         # Change permissions
access()        # Check permissions

system()        # Execute OS command
startfile()     # Open file (Windows)

walk()          # Traverse directories
scandir()       # Directory iterator

getlogin()      # Current user
getpid()        # Process ID
getppid()       # Parent Process ID

environ         # Environment variables
getenv()        # Get environment variable
putenv()        # Set environment variable

path.exists()   # Check path exists
path.isfile()   # Check file
path.isdir()    # Check directory
path.join()     # Join paths
path.basename() # File name
path.dirname()  # Directory name
path.abspath()  # Absolute path
path.getsize()  # File size

cpu_count()     # Number of CPUs
urandom()       # Random bytes
