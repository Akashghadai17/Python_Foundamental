def create_table(size):

    # Create empty hash table
    return [None] * size


def hash_function(key, size):

    return key % size


# INSERT OPERATION
def insert(table, key):

    size = len(table)

    h = hash_function(key, size)

    i = 0

    while table[(h + i**2) % size] is not None:
        i += 1

    index = (h + i**2) % size

    table[index] = key

    print(f"{key} inserted at index {index}")


# SEARCH OPERATION
def search(table, key):

    size = len(table)

    h = hash_function(key, size)

    i = 0

    while table[(h + i**2) % size] is not None:

        index = (h + i**2) % size

        if table[index] == key:
            print(f"{key} found at index {index}")
            return

        i += 1

        if i == size:
            break

    print("Element not found")


# DELETE OPERATION
def delete(table, key):

    size = len(table)

    h = hash_function(key, size)

    i = 0

    while table[(h + i**2) % size] is not None:

        index = (h + i**2) % size

        if table[index] == key:
            table[index] = "DELETED"
            print(f"{key} deleted")
            return

        i += 1

        if i == size:
            break

    print("Element not found")


# DISPLAY OPERATION
def display(table):

    print(table)


