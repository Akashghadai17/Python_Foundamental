# W.A.P to insert elements using Double Hashing
----------------------------------------------
# Create Hash Table
def create_table(size):

    return [None] * size


# Primary Hash Function
def hash1(key, size):

    return key % size


# Secondary Hash Function
def hash2(key, prime):

    return prime - (key % prime)


# Insert Operation
def insert(table, key, prime):

    size = len(table)

    h1 = hash1(key, size)

    h2 = hash2(key, prime)

    i = 0

    while table[(h1 + i * h2) % size] is not None:

        i += 1

    index = (h1 + i * h2) % size

    table[index] = key

    print(f"{key} inserted at index {index}")


# Display Hash Table
def display(table):

    print("\nHash Table")

    for index, value in enumerate(table):

        print(f"{index} -> {value}")


# Main Program
table = create_table(7)

prime = 5

insert(table, 10, prime)
insert(table, 17, prime)
insert(table, 24, prime)
insert(table, 31, prime)

display(table)
